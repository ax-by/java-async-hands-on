<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.cfhandson</groupId>
    <artifactId>cf-handson-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>java-async-hands-on: CompletableFuture 파이프라인 설계 실습</name>

    <modules>
        <module>harness</module>
        <module>m01-mental-model</module>
        <module>m02-composition</module>
        <module>m03-failure</module>
        <module>m04-executors</module>
        <module>m05-design-a</module>
        <module>m06-design-b</module>
        <module>m07-integration</module>
        <module>m07-vt-compare</module>
        <module>m08-bug-hunt</module>
        <module>m09-library-author</module>
        <module>m10-oss-reading</module>
        <module>m11-capstone</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 실습 코드는 운영 환경(Java 17)에서 그대로 쓸 수 있는 API만 허용한다. 모듈별로 재정의한다. -->
        <maven.compiler.release>17</maven.compiler.release>

        <!-- m07(Spring Boot 3.5.x)과 충돌하지 않도록 Boot BOM이 관리하는 버전에 맞춘다. -->
        <junit.version>5.12.2</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <awaitility.version>4.2.2</awaitility.version>
        <blockhound.version>1.0.17.RELEASE</blockhound.version>
        <spring-boot.version>3.5.16</spring-boot.version>

        <!-- 컴파일할 소스 폴더. `-Psolutions` 프로필이 solutions/ 아래의 참고 해답으로 바꾼다. -->
        <main.source.dir>src/main/java</main.source.dir>
        <test.source.dir>src/test/java</test.source.dir>
        <!-- 모듈이 재정의할 수 있는 해답 위치: 테스트까지 다른 모듈만 solutions.test.source.dir 를 바꾼다. -->
        <solutions.main.source.dir>solutions/src/main/java</solutions.main.source.dir>
        <solutions.test.source.dir>src/test/java</solutions.test.source.dir>
        <!-- learner | solutions. solutions 일 때는 예측 ledger 를 기록하지 않는다. -->
        <cfhandson.mode>learner</cfhandson.mode>

        <!-- BlockHound(바이트코드 계측)와 JDK 21+ 동적 에이전트 경고 억제 -->
        <surefire.jvm.args>-XX:+AllowRedefinitionToAddDeleteMethods -XX:+EnableDynamicAgentLoading -Xshare:off --sun-misc-unsafe-memory-access=allow</surefire.jvm.args>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.cfhandson</groupId>
                <artifactId>harness</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.awaitility</groupId>
                <artifactId>awaitility</artifactId>
                <version>${awaitility.version}</version>
            </dependency>
            <dependency>
                <groupId>io.projectreactor.tools</groupId>
                <artifactId>blockhound</artifactId>
                <version>${blockhound.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <sourceDirectory>${main.source.dir}</sourceDirectory>
        <testSourceDirectory>${test.source.dir}</testSourceDirectory>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:-options</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.4</version>
                    <configuration>
                        <argLine>${surefire.jvm.args}</argLine>
                        <systemPropertyVariables>
                            <cfhandson.mode>${cfhandson.mode}</cfhandson.mode>
                        </systemPropertyVariables>
                        <trimStackTrace>true</trimStackTrace>
                        <!-- 예측 채점은 실패해도 모든 테스트를 끝까지 돌려 전체 결과를 보여준다 -->
                        <testFailureIgnore>false</testFailureIgnore>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>3.6.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>require-jdk-25</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>이 repo는 JDK 25로 빌드한다 (각 모듈은 --release 로 대상 버전을 강제한다). JAVA_HOME을 확인하라.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- `mvn test -Psolutions`: 학습자 코드 대신 각 모듈 solutions/ 의 참고 해답을 같은 테스트로 검증한다.
             (Maven 은 프로필 안의 <build> 에 sourceDirectory 를 둘 수 없으므로 속성으로 바꾼다.) -->
        <profile>
            <id>solutions</id>
            <properties>
                <main.source.dir>${solutions.main.source.dir}</main.source.dir>
                <test.source.dir>${solutions.test.source.dir}</test.source.dir>
                <cfhandson.mode>solutions</cfhandson.mode>
            </properties>
        </profile>
    </profiles>
</project>
