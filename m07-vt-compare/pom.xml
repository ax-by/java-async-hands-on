<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.cfhandson</groupId>
        <artifactId>cf-handson-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>m07-vt-compare</artifactId>

    <properties>
        <!-- 이 모듈은 테스트 쪽에도 해답이 있다(예측 시트, 정답을 단언하는 사실 검증 테스트) -->
        <solutions.test.source.dir>solutions/src/test/java</solutions.test.source.dir>
        <!-- 가상 스레드(21), ScopedValue(25 정식), StructuredTaskScope(25 preview, JEP 505) 를 쓰는 비교 모듈 -->
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.cfhandson</groupId>
            <artifactId>harness</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.children="append">
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${surefire.jvm.args} --enable-preview</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
